# SQLite (local dev). Use a TEMPORARY file for migrate/seed experiments and
# delete it afterwards; never commit a *.db file with real data.
DATABASE_URL="file:./prisma/dev.db"

# JWT Secret for Auth — REQUIRED. The server refuses to start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-secret-in-production"

# CORS origins, comma-separated. Default: http://localhost:3001
CORS_ORIGIN="http://localhost:3001"

# Port (default 3000)
PORT=3000

# Face model weights dir (default: ./weights, i.e. apps/api/weights).
# Download with: bash scripts/download-face-weights.sh
# Without valid weights, /face/enroll + /face/verify + face-gated check-in
# answer 503 (never a fake success).
FACE_WEIGHTS_DIR="./weights"

# Report work hours (HH:MM, server-local time) used ONLY to derive
# late/overtime flags in /reports/attendance. There is no per-office or
# per-user shift model yet; these are company-wide defaults.
WORK_START_TIME="08:00"
WORK_END_TIME="17:00"
